# Copy to .env and fill in what you use. .env is git-ignored.

# Any OpenAI-compatible endpoint (OpenAI, Groq, OpenRouter, Gemini's OpenAI-compatible API, Ollama...)
OPENAI_API_KEY=
# Leave empty for api.openai.com. Examples:
#   https://api.groq.com/openai/v1
#   https://openrouter.ai/api/v1
#   https://generativelanguage.googleapis.com/v1beta/openai
#   http://localhost:11434/v1   (Ollama, no key needed)
OPENAI_BASE_URL=

# Anthropic Messages API
ANTHROPIC_API_KEY=
